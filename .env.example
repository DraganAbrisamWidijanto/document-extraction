# Copy to .env and fill in. Never commit the real .env or geminiapi.txt.
# The API reads config from these vars at startup (app/extractor.py).

# --- VLM provider (OpenAI-compatible endpoint; Gemini by default) ---
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VLM_MODEL=gemini-3.5-flash-lite

# API key(s): either a single key here (docker/CI) ...
# VLM_API_KEY=
# ... or a file with one key per line (all keys are round-robined; default <repo>/geminiapi.txt)
# VLM_API_KEY_FILE=C:\path\to\your\geminiapi.txt

# --- Request behaviour ---
VLM_TIMEOUT_S=180
VLM_MAX_TOKENS=3000
VLM_RETRIES=3

# --- Cost tracking (USD per 1M tokens; 0 = free tier) ---
VLM_PRICE_INPUT_PER_M=0
VLM_PRICE_OUTPUT_PER_M=0

# --- Eval / batch ---
# VLM_CONCURRENCY=4   (workers for batch_extract.py)
